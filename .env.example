# HA Long-Lived Access Token. Create in HA: profile picture → Säkerhet → Long-Lived Access Tokens.
SUPERVISOR_TOKEN=

# HA WebSocket endpoint. Use the IP if mDNS fails.
ARGUS_HA_WS_URL=ws://homeassistant.local:8123/api/websocket

# Argus backend WebSocket endpoint. Point at the LAN backend during dev; the deployed VPS once ws.argus.ixdev.se is live.
ARGUS_CLOUD_URL=ws://192.168.1.10:8000/ws/addon
